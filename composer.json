{
    "name": "agencetwogether/hookshelper",
    "description": "Simple plugin to toggle display hooks available in current page.",
    "keywords": [
        "agencetwogether",
        "laravel",
        "filamentphp",
        "filament",
        "hooks",
        "helper"
    ],
    "homepage": "https://github.com/agencetwogether/hookshelper",
    "support": {
        "issues": "https://github.com/agencetwogether/hookshelper/issues",
        "source": "https://github.com/agencetwogether/hookshelper"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Max",
            "email": "contact@agencetwogether.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0|^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9|^8.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.1|^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Agencetwogether\\HooksHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agencetwogether\\HooksHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Agencetwogether\\HooksHelper\\HooksHelperServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
